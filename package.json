{
  "name": "hd-garden",
  "version": "0.8.0",
  "private": false,
  "description": "用 Markdown 写作、用 GitHub Pages 发布的个人博客引擎。",
  "license": "MIT",
  "homepage": "https://github.com/hedon954/garden",
  "bugs": {
    "url": "https://github.com/hedon954/garden/issues"
  },
  "keywords": [
    "hd-garden",
    "blog",
    "markdown",
    "github-pages",
    "static-site"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "garden": "bin/garden.mjs",
    "hd-garden": "bin/garden.mjs"
  },
  "files": [
    "app",
    "bin",
    "build",
    "docs/handbook",
    "public/favicon.svg",
    "public/apple-touch-icon.png",
    "public/og.png",
    "public/images",
    "scripts",
    "templates",
    "ui",
    "worker",
    ".agents",
    ".env.example",
    ".env.en.example",
    ".openai",
    "Makefile",
    "eslint.config.mjs",
    "next.config.ts",
    "postcss.config.mjs",
    "site.config.yaml",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedon954/garden.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:sync": "node bin/garden.mjs sync",
    "pages:validate": "node bin/garden.mjs pages:validate",
    "webmentions:send": "node bin/garden.mjs webmentions",
    "predev": "npm run content:sync",
    "dev": "node bin/garden.mjs dev",
    "prebuild": "npm run content:sync",
    "build": "node bin/garden.mjs build",
    "start": "node bin/garden.mjs start",
    "admin:local": "npm run start -- --host 0.0.0.0 --port 3000",
    "admin:cloudflare": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "ui:build": "node scripts/build-ui-preview.mjs",
    "editors:build": "node editors/vscode/build.mjs && node editors/obsidian/build.mjs && node editors/typora/build.mjs",
    "prepack": "node scripts/build-ui-preview.mjs",
    "lint": "node bin/garden.mjs sync && eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .garden --ignore-pattern templates"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "acorn": "^8.19.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "katex": "^0.16.47",
    "marked": "^16.4.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-mdx-expression": "^2.0.1",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "micromark-extension-mdx-expression": "^3.0.1",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "next": "16.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "19.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vinext": "1.2.1",
    "vite": "8.0.13",
    "wrangler": "4.116.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12"
  },
  "type": "module"
}
