# 网站正式公开地址，不要以 / 结尾。
SITE_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com

# Giscus：在 https://giscus.app 配置后复制以下四项。
GISCUS_REPO=owner/repository
GISCUS_REPO_ID=R_xxxxxxxxxx
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=DIC_xxxxxxxxxx

# Webmention.io：注册正式域名后填写域名，不含 https://。
WEBMENTION_IO_DOMAIN=example.com

# 可选：使用自建接收端点时覆盖 Webmention.io 默认端点。
# WEBMENTION_ENDPOINT=https://example.com/webmention

# 可选：提高 GitHub 资料接口额度。仅服务端使用，不会发送到浏览器。
# GITHUB_TOKEN=github_pat_xxx

# 可选：无 Cookie 的访问统计，例如 Plausible。
# NEXT_PUBLIC_ANALYTICS_DOMAIN=example.com
# NEXT_PUBLIC_ANALYTICS_SCRIPT=https://plausible.io/js/script.js

# 可选：本地构建时预览草稿和未来文章。
# CONTENT_INCLUDE_DRAFTS=1
