# 公开博客的正式地址，不要以 / 结尾。GitHub Pages 构建与独立后台都使用它。
SITE_URL=https://your-name.github.io
NEXT_PUBLIC_SITE_URL=https://your-name.github.io

# 独立管理后台的地址；公开博客静态导出时 /admin 会跳转到这里。
ADMIN_URL=https://admin.example.com

# 可选：反向代理或多域名后台时，显式指定 GitHub OAuth 回调地址。
# GITHUB_OAUTH_REDIRECT_URI=https://admin.example.com/api/auth/github/callback

# Giscus：在 https://giscus.app 配置后复制以下四项。
GISCUS_REPO=owner/repository
GISCUS_REPO_ID=R_xxxxxxxxxx
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=DIC_xxxxxxxxxx

# Webmention.io：注册正式域名后填写域名，不含 https://。
WEBMENTION_IO_DOMAIN=example.com

# 可选：使用自建接收端点时覆盖 Webmention.io 默认端点。
# WEBMENTION_ENDPOINT=https://example.com/webmention

# 可选：提高 GitHub 资料接口额度。仅服务端使用，不会发送到浏览器。
# GITHUB_TOKEN=github_pat_xxx

# 可选：无 Cookie 的访问统计，例如 Plausible。
# NEXT_PUBLIC_ANALYTICS_DOMAIN=example.com
# NEXT_PUBLIC_ANALYTICS_SCRIPT=https://plausible.io/js/script.js

# 可选：本地构建时预览草稿和未来文章。
# CONTENT_INCLUDE_DRAFTS=1

# 管理后台：GitHub OAuth App、后台身份白名单，以及写入内容仓库的细粒度 PAT。
# Callback URL: https://admin.example.com/api/auth/github/callback
# CONTENT_REPOSITORY=owner/repository
# CONTENT_BRANCH=main
# CONTENT_GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# GITHUB_OAUTH_CLIENT_ID=Ov23li_xxxxxxxxxxxx
# GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# GITHUB_SESSION_SECRET=请使用至少32字符的随机字符串
# ADMIN_GITHUB_LOGINS=your-github-login

# 内容分发：X 使用拥有发帖权限的用户访问令牌；其余平台接入你自己的发布桥接服务。
# X_USER_ACCESS_TOKEN=xxxxxxxx
# CSDN_SYNC_WEBHOOK=https://publisher.example.com/csdn
# ZHIHU_SYNC_WEBHOOK=https://publisher.example.com/zhihu
# JUEJIN_SYNC_WEBHOOK=https://publisher.example.com/juejin
