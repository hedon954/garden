# Public blog canonical URL without a trailing slash. Used by GitHub Pages builds and the standalone admin studio.
SITE_URL=https://your-name.github.io
NEXT_PUBLIC_SITE_URL=https://your-name.github.io

# Standalone admin studio URL; static exports redirect /admin here.
ADMIN_URL=https://admin.example.com

# Optional: explicit GitHub OAuth callback URL when behind a reverse proxy or multiple domains.
# GITHUB_OAUTH_REDIRECT_URI=https://admin.example.com/api/auth/github/callback

# Comments are disabled by default. Open https://giscus.app, install the app, uncomment below, and fill in real values.
# The repository must be public (owner/name) with Discussions enabled.
# Also add the same four variables under GitHub Actions Variables for production builds.
# To publish without comments, set the Actions Variable GISCUS_DISABLED to 1.
# GISCUS_REPO=
# GISCUS_REPO_ID=
# GISCUS_CATEGORY=
# GISCUS_CATEGORY_ID=

# Webmention.io: set your domain (without https://) after registering a custom domain.
WEBMENTION_IO_DOMAIN=example.com

# Optional: override the default Webmention.io endpoint when self-hosting.
# WEBMENTION_ENDPOINT=https://example.com/webmention

# Optional: display exact commit counts, pinned repositories, and contribution graph on /about locally. Server-only.
# GITHUB_TOKEN=github_pat_xxx

# Optional: cookie-free analytics, such as Plausible.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=example.com
# NEXT_PUBLIC_ANALYTICS_SCRIPT=https://plausible.io/js/script.js

# Optional: include drafts and future-dated posts during local builds.
# CONTENT_INCLUDE_DRAFTS=1

# Admin studio: GitHub OAuth App, allowed logins, and fine-grained PAT for writing to the content repository.
# Callback URL: https://admin.example.com/api/auth/github/callback
# CONTENT_REPOSITORY=owner/repository
# CONTENT_BRANCH=main
# CONTENT_GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# GITHUB_OAUTH_CLIENT_ID=Ov23li_xxxxxxxxxxxx
# GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# GITHUB_SESSION_SECRET=use-a-random-string-at-least-32-characters-long
# ADMIN_GITHUB_LOGINS=your-github-login

# Admin media: Alibaba Cloud OSS. AccessKeys stay on the admin server and are never sent to the browser.
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=your-public-media-bucket
# OSS_ACCESS_KEY_ID=LTAIxxxxxxxx
# OSS_ACCESS_KEY_SECRET=xxxxxxxx
# OSS_PREFIX=blog-media
# OSS_PUBLIC_BASE_URL=https://media.example.com
# OSS_MAX_UPLOAD_MB=200

# Admin UI studio: OpenAI-compatible endpoint. API keys stay on the admin server only.
# UI_MODEL_BASE_URL=https://api.openai.com/v1
# UI_MODEL_API_KEY=sk-xxxxxxxx
# UI_MODEL_NAME=gpt-5.6
# UI_DRAFT_RATE_LIMIT=60
# Optional: GitHub Enterprise or local mock API base URL.
# GITHUB_API_URL=https://api.github.com

# Content distribution: X uses a user access token with write permissions; other platforms use your webhook bridges.
# X_USER_ACCESS_TOKEN=xxxxxxxx
# CSDN_SYNC_WEBHOOK=https://publisher.example.com/csdn
# ZHIHU_SYNC_WEBHOOK=https://publisher.example.com/zhihu
# JUEJIN_SYNC_WEBHOOK=https://publisher.example.com/juejin
