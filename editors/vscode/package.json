{
  "name": "garden-ui",
  "displayName": "Garden Intelligent UI",
  "description": "在 Markdown 里插入、预览和检查 Garden 块（compose DIL / card / interactive…）。",
  "version": "0.1.1",
  "publisher": "hedon954",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hedon954/garden"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "markdown",
    "garden",
    "intelligent ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/garden-ui.iife.js",
      "./dist/preview.js"
    ],
    "markdown.previewStyles": [
      "./dist/garden-ui.css",
      "./dist/preview.css"
    ],
    "commands": [
      {
        "command": "garden.insertIntent",
        "title": "插入 Garden 块",
        "category": "Garden"
      },
      {
        "command": "garden.copyCompilePrompt",
        "title": "复制编译提示词",
        "category": "Garden"
      },
      {
        "command": "garden.openCatalog",
        "title": "查看组件清单",
        "category": "Garden"
      },
      {
        "command": "garden.foldBlock",
        "title": "收起当前 Garden 块",
        "category": "Garden"
      },
      {
        "command": "garden.unfoldBlock",
        "title": "展开当前 Garden 块",
        "category": "Garden"
      },
      {
        "command": "garden.foldAllBlocks",
        "title": "收起全部 Garden 块",
        "category": "Garden"
      },
      {
        "command": "garden.unfoldAllBlocks",
        "title": "展开全部 Garden 块",
        "category": "Garden"
      }
    ],
    "keybindings": [
      {
        "command": "garden.insertIntent",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "garden.insertIntent",
          "when": "editorLangId == markdown",
          "group": "garden@1"
        },
        {
          "command": "garden.copyCompilePrompt",
          "when": "editorLangId == markdown",
          "group": "garden@2"
        },
        {
          "command": "garden.foldBlock",
          "when": "editorLangId == markdown",
          "group": "garden@3"
        },
        {
          "command": "garden.unfoldBlock",
          "when": "editorLangId == markdown",
          "group": "garden@3"
        },
        {
          "command": "garden.foldAllBlocks",
          "when": "editorLangId == markdown",
          "group": "garden@3"
        },
        {
          "command": "garden.unfoldAllBlocks",
          "when": "editorLangId == markdown",
          "group": "garden@3"
        }
      ],
      "commandPalette": [
        {
          "command": "garden.insertIntent",
          "when": "editorLangId == markdown"
        },
        {
          "command": "garden.copyCompilePrompt",
          "when": "editorLangId == markdown"
        },
        {
          "command": "garden.foldBlock",
          "when": "editorLangId == markdown"
        },
        {
          "command": "garden.unfoldBlock",
          "when": "editorLangId == markdown"
        },
        {
          "command": "garden.foldAllBlocks",
          "when": "editorLangId == markdown"
        },
        {
          "command": "garden.unfoldAllBlocks",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "markdown.garden-ui.codeblock",
        "path": "./syntaxes/ui-codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.garden-ui": "markdown"
        }
      }
    ],
    "configuration": {
      "title": "Garden",
      "properties": {
        "garden.foldUiBodies": {
          "type": "boolean",
          "default": true,
          "description": "打开稿件时使用 Markdown 原生折叠收起旧版 ui 整块，只露出围栏首行。"
        }
      }
    },
    "configurationDefaults": {
      "[markdown]": {
        "editor.folding": true,
        "editor.foldingStrategy": "auto",
        "editor.showFoldingControls": "always"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0"
  }
}
